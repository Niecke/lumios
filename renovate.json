{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "semanticCommitType": "fix",
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "OpenTelemetry core and instrumentation packages are released in lockstep, so they must be updated together.",
      "matchPackageNames": [
        "opentelemetry-*"
      ],
      "groupName": "opentelemetry"
    },
    {
      "description": "Digest-only updates of already-pinned images carry no new version, so the age gate does not apply.",
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    }
  ]
}
